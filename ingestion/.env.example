# ingestion/.env.example
# Copy to .env and fill in values for local development.
# Never commit the real .env file (it is already in .gitignore).

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token with  repo / actions:read  scope.
# When this env-var is set, Key Vault lookup is skipped entirely.
GITHUB_PAT=ghp_YOUR_PERSONAL_ACCESS_TOKEN_HERE

# Repository to pull from (owner/repo)
GITHUB_REPO=helqadiri03/azure-ai-incident-intelligence-platform

# ── Azure Key Vault (production path) ────────────────────────────────────────
# Name of your Key Vault (matches Terraform output kv-aiip-dev-frc-001)
KEY_VAULT_NAME=kv-aiip-dev-frc-001

# Name of the secret inside Key Vault that holds the GitHub PAT
KEY_VAULT_SECRET_NAME=github-pat

# ── Azure Event Hub (Step 1.3 — now wired) ────────────────────────────────────
# Terraform stores the connection string in Key Vault automatically on apply.
# Key Vault secret name (matches what event_hub_producer.py reads by default):
# KEY_VAULT_SECRET_NAME=eventhub-connection-string

# Shortcut for local dev: paste the raw connection string to skip Key Vault.
# Get it from: Portal → Event Hub Namespace → Shared access policies → aiip-ingestion-send
# EVENTHUB_CONNECTION_STRING=Endpoint=sb://evhns-aiip-dev-frc-001.servicebus.windows.net/;SharedAccessKeyName=aiip-ingestion-send;SharedAccessKey=<key>

# Hub names (defaults already coded — only override if renamed)
# EVENTHUB_DEPLOYMENT_HUB=aiip-deployment-events
# EVENTHUB_INCIDENT_HUB=aiip-incident-events
